# Supabase PostgreSQL connection URI (same database as backend/.env DB_URL).
# Use the "Session pooler" URI from Supabase dashboard > Connect.
DATABASE_URL=

# Local Ollama
OLLAMA_URL=http://127.0.0.1:11434
EMBED_MODEL=nomic-embed-text
CHAT_MODEL=llama3.2

# Must be identical to INTERNAL_API_SECRET in backend/.env
INTERNAL_API_SECRET=

# Optional tuning
# TOP_K=5
# MIN_SIMILARITY=0.55
# CHUNK_SIZE=800
# CHUNK_OVERLAP=150
# Database connection pool: connections kept open between requests, and the most open at once
# DB_POOL_MIN=2
# DB_POOL_MAX=8
# OCR (see requirements-ocr.txt)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# OCR_MAX_PAGES=50
